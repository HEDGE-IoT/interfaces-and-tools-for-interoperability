###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class ;
             rdfs:subClassOf bito:BehavioralElement ;
             rdfs:comment "Reused to represent a temporal instant when explicit temporal modelling is required."@en ;
             rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
             rdfs:label "Instant"@en ;
