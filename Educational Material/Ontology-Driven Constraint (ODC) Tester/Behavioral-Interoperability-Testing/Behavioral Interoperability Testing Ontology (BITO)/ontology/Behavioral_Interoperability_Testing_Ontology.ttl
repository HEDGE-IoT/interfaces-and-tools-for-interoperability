###  https://w3id.org/bito/example/flexible-start#TraceEvidence_S1
ex:TraceEvidence_S1 rdf:type owl:NamedIndividual ,
                             bito:TraceEvidence ;
                    bito:observedOptionalPowerSequence ex:PowerSequence_45 ;
                    bito:observedPreferredPowerSequence ex:PowerSequence_44 ;
                    bito:evidenceMode "independentScenarioSessions" ;
                    bito:evidencePreservesInteractionContext "true"^^xsd:boolean ;
                    bito:evidencePreservesObservedBehavior "true"^^xsd:boolean ;
                    bito:observedAt "2025-07-15T09:00:00+00:00"^^xsd:dateTime ;
                    bito:observedPlanStatus "VALID" ;
                    rdfs:label "Scenario 1 trace evidence"@en .


###  https://w3id.org/bito/example/flexible-start#TraceEvidence_S2
ex:TraceEvidence_S2 rdf:type owl:NamedIndividual ,
                             bito:TraceEvidence ;
                    bito:observedScheduledPowerSequence ex:PowerSequence_44 ;
                    bito:evidenceMode "independentScenarioSessions" ;
                    bito:evidencePreservesInteractionContext "true"^^xsd:boolean ;
                    bito:evidencePreservesObservedBehavior "true"^^xsd:boolean ;
                    bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                    bito:observedExecutionStart "2025-07-15T11:00:20+00:00"^^xsd:dateTime ;
                    bito:observedPlanUpdatedAt "2025-07-15T09:30:03+00:00"^^xsd:dateTime ;
                    bito:observedRunStatus "COMPLETED" ;
                    rdfs:label "Scenario 2 trace evidence"@en .


###  https://w3id.org/bito/example/flexible-start#TraceEvidence_S3
ex:TraceEvidence_S3 rdf:type owl:NamedIndividual ,
                             bito:TraceEvidence ;
                    bito:observedFormerPreferredPowerSequence ex:PowerSequence_44 ;
                    bito:observedSelectedPowerSequence ex:PowerSequence_45 ;
                    bito:evidenceMode "independentScenarioSessions" ;
                    bito:evidencePreservesInteractionContext "true"^^xsd:boolean ;
                    bito:evidencePreservesObservedBehavior "true"^^xsd:boolean ;
                    bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                    bito:observedExecutionStart "2025-07-15T12:00:20+00:00"^^xsd:dateTime ;
                    bito:observedPlanUpdatedAt "2025-07-15T10:45:04+00:00"^^xsd:dateTime ;
                    bito:observedRunStatus "COMPLETED" ;
                    rdfs:label "Scenario 3 trace evidence"@en .


###  https://w3id.org/bito/example/flexible-start#Transition_S1_PlanAvailable
ex:Transition_S1_PlanAvailable rdf:type owl:NamedIndividual ,
                                        bito:ExpectedStateTransition ;
                               bito:hasRelevantPowerSequence ex:PowerSequence_44 ,
                                                            ex:PowerSequence_45 ;
                               bito:hasSourceState s4ener:Inactive ;
                               bito:hasTargetState s4ener:Scheduled ;
                               rdfs:label "Plan available transition"@en .


###  https://w3id.org/bito/example/flexible-start#Transition_S2_PreferredSequenceShifted
ex:Transition_S2_PreferredSequenceShifted rdf:type owl:NamedIndividual ,
                                                   bito:ExpectedStateTransition ;
                                          bito:hasRelevantPowerSequence ex:PowerSequence_44 ;
                                          bito:hasSourceState s4ener:Scheduled ;
                                          bito:hasTargetState s4ener:Scheduled ;
                                          rdfs:label "Preferred sequence shifted transition"@en .


###  https://w3id.org/bito/example/flexible-start#Transition_S3_FormerPreferredInactive
ex:Transition_S3_FormerPreferredInactive rdf:type owl:NamedIndividual ,
                                                  bito:ExpectedStateTransition ;
                                         bito:hasRelevantPowerSequence ex:PowerSequence_44 ;
                                         bito:hasSourceState s4ener:Scheduled ;
                                         bito:hasTargetState s4ener:Inactive ;
                                         rdfs:label "Former preferred sequence inactive transition"@en .


###  https://w3id.org/bito/example/flexible-start#Transition_S3_SelectedSequenceScheduled
ex:Transition_S3_SelectedSequenceScheduled rdf:type owl:NamedIndividual ,
                                                    bito:ExpectedStateTransition ;
                                           bito:hasRelevantPowerSequence ex:PowerSequence_45 ;
                                           bito:hasSourceState s4ener:Inactive ;
                                           bito:hasTargetState s4ener:Scheduled ;
                                           rdfs:label "Selected sequence scheduled transition"@en .


###  https://w3id.org/bito/example/flexible-start#UCF_Plan_With_Power_Sequences
ex:UCF_Plan_With_Power_Sequences rdf:type owl:NamedIndividual ,
                                          bito:UseCaseFunction ;
                                 bito:ucfName "UCF_Plan_With_Power_Sequences" ;
                                 rdfs:label "UCF Plan With Power Sequences"@en .


###  https://w3id.org/bito/example/flexible-start#UCF_Select_Power_Sequence
ex:UCF_Select_Power_Sequence rdf:type owl:NamedIndividual ,
                                      bito:UseCaseFunction ;
                             bito:ucfName "UCF_Select_Power_Sequence" ;
                             rdfs:label "UCF Select Power Sequence"@en .


###  https://w3id.org/bito/example/flexible-start#UCF_Shift_Preferred_Power_Sequence
ex:UCF_Shift_Preferred_Power_Sequence rdf:type owl:NamedIndividual ,
                                               bito:UseCaseFunction ;
                                      bito:ucfName "UCF_Shift_Preferred_Power_Sequence" ;
                                      rdfs:label "UCF Shift Preferred Power Sequence"@en .


###  https://w3id.org/bito/example/flexible-start#ValidationResult_S1
ex:ValidationResult_S1 rdf:type owl:NamedIndividual ,
                                bito:ValidationResult ;
                       bito:basedOnTraceEvidence ex:TraceEvidence_S1 ;
                       bito:hasVerdict bito:PASS ;
                       bito:validatesConstraint ex:Constraint_S1_PlanStatus ,
                                               ex:Constraint_S1_PlanStructure ;
                       bito:achievesExpectedOutcome "true"^^xsd:boolean ;
                       bito:satisfiesConstraint "true"^^xsd:boolean ;
                       bito:validationMessage "Scenario 1 evidence represents a valid announced plan." ;
                       rdfs:label "Scenario 1 validation result"@en .


###  https://w3id.org/bito/example/flexible-start#ValidationResult_S2
ex:ValidationResult_S2 rdf:type owl:NamedIndividual ,
                                bito:ValidationResult ;
                       bito:basedOnTraceEvidence ex:TraceEvidence_S2 ;
                       bito:hasVerdict bito:PASS ;
                       bito:validatesConstraint ex:Constraint_S2_RequestAccepted ,
                                               ex:Constraint_S2_RunCompleted ,
                                               ex:Constraint_S2_StartTimeUpdated ;
                       bito:achievesExpectedOutcome "true"^^xsd:boolean ;
                       bito:satisfiesConstraint "true"^^xsd:boolean ;
                       bito:validationMessage "Scenario 2 evidence represents an accepted preferred-sequence shift and completed execution." ;
                       rdfs:label "Scenario 2 validation result"@en .


###  https://w3id.org/bito/example/flexible-start#ValidationResult_S3
ex:ValidationResult_S3 rdf:type owl:NamedIndividual ,
                                bito:ValidationResult ;
                       bito:basedOnTraceEvidence ex:TraceEvidence_S3 ;
                       bito:hasVerdict bito:PASS ;
                       bito:validatesConstraint ex:Constraint_S3_FormerPreferredInactive ,
                                               ex:Constraint_S3_RequestAccepted ,
                                               ex:Constraint_S3_RunCompleted ,
                                               ex:Constraint_S3_SelectedSequenceScheduled ;
                       bito:achievesExpectedOutcome "true"^^xsd:boolean ;
                       bito:satisfiesConstraint "true"^^xsd:boolean ;
                       bito:validationMessage "Scenario 3 evidence represents an accepted alternative-sequence selection and completed execution." ;
                       rdfs:label "Scenario 3 validation result"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( bito:BehavioralConstraint
                bito:ExpectedOperationalOutcome
                bito:ExpectedStateTransition
                bito:ObservedEvent
                bito:ObservedExecution
                bito:ObservedStateChange
                bito:Scenario
                bito:TraceEvidence
                bito:UseCase
                bito:UseCaseFunction
                bito:ValidationResult
                bito:ValidationVerdict
              )
] .



