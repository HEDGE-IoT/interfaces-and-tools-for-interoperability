@prefix : <https://w3id.org/bito#> .
@prefix ex: <https://w3id.org/bito/example/flexible-start#> .
@prefix bito: <https://w3id.org/bito#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix s4ener: <https://saref.etsi.org/saref4ener/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/bito> .

<https://w3id.org/bito> rdf:type owl:Ontology ;
                        owl:versionIRI <https://w3id.org/bito/1.0.0> ;
                        dcterms:created "2026-05-20"^^xsd:date ;
                        dcterms:creator "Cornelis Bouter (TNO)"@en ,
                                        "Laura Daniele (TNO)"@en ,
                                        "Tareq Md Rabiul Hossain Chy (Trialog)"@en ;
                        dcterms:description "Ontology for representing use cases, scenarios, expected behavior, observed execution evidence, constraints, validation results, and verdicts for ontology-driven behavioral validation."@en ;
                        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                        dcterms:modified "2026-06-03"^^xsd:date ;
                        dcterms:title "Behavioral Interoperability Testing Ontology (BITO)"@en ;
                        vann:preferredNamespacePrefix "bito"@en ;
                        vann:preferredNamespaceUri "https://w3id.org/bito#" ;
                        rdfs:comment "It contains the behavioral vocabulary, selected reused ontology terms, and instances."@en ;
                        owl:versionInfo "1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  https://w3id.org/bito#sourceOntology
bito:sourceOntology rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Ontology or vocabulary from which the term is reused or in which the term is defined."@en ;
                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                   rdfs:label "source ontology"@en ;
                   bito:sourceOntology <https://w3id.org/bito> ;
                   bito:sourceTermPage bito:sourceOntology .


###  https://w3id.org/bito#sourceTermPage
bito:sourceTermPage rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Term IRI or reference page for the class, property, or individual."@en ;
                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                   rdfs:label "source term page"@en ;
                   bito:sourceOntology <https://w3id.org/bito> ;
                   bito:sourceTermPage bito:sourceTermPage .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://saref.etsi.org/core/consistsOf
saref:consistsOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf bito:isComponentOf ;
                 rdfs:domain bito:StructuralContainer ;
                 rdfs:range bito:StructuralElement ;
                 rdfs:comment "Reused to connect power profiles to alternatives groups, alternatives groups to power sequences, and power sequences to slots."@en ;
                 rdfs:isDefinedBy saref: ;
                 rdfs:label "consists of"@en ;
                 bito:sourceOntology saref: ;
                 bito:sourceTermPage saref:consistsOf .


###  https://saref.etsi.org/core/hasState
saref:hasState rdf:type owl:ObjectProperty ;
               owl:inverseOf bito:isStateOf ;
               rdfs:domain bito:BehavioralElement ;
               rdfs:range saref:State ;
               rdfs:comment "Reused to connect an entity to a state."@en ;
               rdfs:isDefinedBy saref: ;
               rdfs:label "has state"@en ;
               bito:sourceOntology saref: ;
               bito:sourceTermPage saref:hasState .


###  https://saref.etsi.org/core/isMeasuredIn
saref:isMeasuredIn rdf:type owl:ObjectProperty ;
                   owl:inverseOf bito:isUnitOfMeasureFor ;
                   rdfs:domain saref:PropertyValue ;
                   rdfs:range saref:UnitOfMeasure ;
                   rdfs:comment "Reused to connect a value to its unit of measure."@en ;
                   rdfs:isDefinedBy saref: ;
                   rdfs:label "is measured in"@en ;
                   bito:sourceOntology saref: ;
                   bito:sourceTermPage saref:isMeasuredIn .


###  https://saref.etsi.org/saref4ener/belongsTo
s4ener:belongsTo rdf:type owl:ObjectProperty ;
                 owl:inverseOf bito:hasBelongingElement ;
                 rdfs:domain bito:StructuralElement ;
                 rdfs:range bito:StructuralContainer ;
                 rdfs:comment "Reused to connect slots, power sequences, alternatives groups, and power profiles to their containing element."@en ;
                 rdfs:isDefinedBy s4ener: ;
                 rdfs:label "belongs to"@en ;
                 bito:sourceOntology s4ener: ;
                 bito:sourceTermPage s4ener:belongsTo .


###  https://w3id.org/bito#appliesTo
bito:appliesTo rdf:type owl:ObjectProperty ;
              owl:inverseOf bito:isAppliedBy ;
              rdfs:domain bito:BehavioralConstraint ;
              rdfs:range bito:BehavioralElement ;
              rdfs:comment "Links a behavioral constraint to the behavioral element it constrains."@en ;
              rdfs:isDefinedBy <https://w3id.org/bito> ;
              rdfs:label "applies to"@en ;
              bito:sourceOntology <https://w3id.org/bito> ;
              bito:sourceTermPage bito:appliesTo .


###  https://w3id.org/bito#basedOnTraceEvidence
bito:basedOnTraceEvidence rdf:type owl:ObjectProperty ;
                         owl:inverseOf bito:isTraceEvidenceBasisOf ;
                         rdfs:domain bito:ValidationResult ;
                         rdfs:range bito:TraceEvidence ;
                         rdfs:comment "Links a validation result to the trace evidence used to derive it."@en ;
                         rdfs:isDefinedBy <https://w3id.org/bito> ;
                         rdfs:label "based on trace evidence"@en ;
                         bito:sourceOntology <https://w3id.org/bito> ;
                         bito:sourceTermPage bito:basedOnTraceEvidence .


###  https://w3id.org/bito#hasBehavioralConstraint
bito:hasBehavioralConstraint rdf:type owl:ObjectProperty ;
                            owl:inverseOf bito:isBehavioralConstraintOf ;
                            rdfs:domain bito:Scenario ;
                            rdfs:range bito:BehavioralConstraint ;
                            rdfs:comment "Links a scenario to an applicable behavioral constraint."@en ;
                            rdfs:isDefinedBy <https://w3id.org/bito> ;
                            rdfs:label "has behavioral constraint"@en ;
                            bito:sourceOntology <https://w3id.org/bito> ;
                            bito:sourceTermPage bito:hasBehavioralConstraint .


###  https://w3id.org/bito#hasBelongingElement
bito:hasBelongingElement rdf:type owl:ObjectProperty ;
                        rdfs:domain bito:StructuralContainer ;
                        rdfs:range bito:StructuralElement ;
                        rdfs:comment "Links a structural container to a structural element it directly contains, such as a power sequence to its slots."@en ;
                        rdfs:isDefinedBy <https://w3id.org/bito> ;
                        rdfs:label "Has Belonging Element"@en ;
                        bito:sourceOntology <https://w3id.org/bito> ;
                        bito:sourceTermPage bito:hasBelongingElement .


###  https://w3id.org/bito#hasExpectedOperationalOutcome
bito:hasExpectedOperationalOutcome rdf:type owl:ObjectProperty ;
                                  owl:inverseOf bito:isExpectedOperationalOutcomeOf ;
                                  rdfs:domain bito:Scenario ;
                                  rdfs:range bito:ExpectedOperationalOutcome ;
                                  rdfs:comment "Links a scenario to the outcome expected from valid execution."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/bito> ;
                                  rdfs:label "has expected operational outcome"@en ;
                                  bito:sourceOntology <https://w3id.org/bito> ;
                                  bito:sourceTermPage bito:hasExpectedOperationalOutcome .


###  https://w3id.org/bito#hasExpectedStateTransition
bito:hasExpectedStateTransition rdf:type owl:ObjectProperty ;
                               owl:inverseOf bito:isExpectedStateTransitionOf ;
                               rdfs:domain bito:Scenario ;
                               rdfs:range bito:ExpectedStateTransition ;
                               rdfs:comment "Links a scenario to an expected state transition."@en ;
                               rdfs:isDefinedBy <https://w3id.org/bito> ;
                               rdfs:label "has expected state transition"@en ;
                               bito:sourceOntology <https://w3id.org/bito> ;
                               bito:sourceTermPage bito:hasExpectedStateTransition .


###  https://w3id.org/bito#hasIUT
bito:hasIUT rdf:type owl:ObjectProperty ;
           owl:inverseOf bito:isIUTOf ;
           rdfs:domain bito:Scenario ;
           rdfs:range saref:Device ;
           rdfs:comment "Links a scenario to the implementation under test."@en ;
           rdfs:isDefinedBy <https://w3id.org/bito> ;
           rdfs:label "has IUT"@en ;
           bito:sourceOntology <https://w3id.org/bito> ;
           bito:sourceTermPage bito:hasIUT .


###  https://w3id.org/bito#hasInteractingActorSystem
bito:hasInteractingActorSystem rdf:type owl:ObjectProperty ;
                              owl:inverseOf bito:isInteractingActorSystemOf ;
                              rdfs:domain bito:Scenario ;
                              rdfs:range prov:Agent ;
                              rdfs:comment "Links a scenario to the external actor or system interacting with the IUT."@en ;
                              rdfs:isDefinedBy <https://w3id.org/bito> ;
                              rdfs:label "has interacting actor system"@en ;
                              bito:sourceOntology <https://w3id.org/bito> ;
                              bito:sourceTermPage bito:hasInteractingActorSystem .


###  https://w3id.org/bito#hasObservedEvent
bito:hasObservedEvent rdf:type owl:ObjectProperty ;
                     owl:inverseOf bito:isObservedEventOf ;
                     rdfs:domain bito:ObservedExecution ;
                     rdfs:range bito:ObservedEvent ;
                     rdfs:comment "Links an observed execution to an observed event."@en ;
                     rdfs:isDefinedBy <https://w3id.org/bito> ;
                     rdfs:label "has observed event"@en ;
                     bito:sourceOntology <https://w3id.org/bito> ;
                     bito:sourceTermPage bito:hasObservedEvent .


###  https://w3id.org/bito#hasObservedExecution
bito:hasObservedExecution rdf:type owl:ObjectProperty ;
                         owl:inverseOf bito:isObservedExecutionOf ;
                         rdfs:domain bito:Scenario ;
                         rdfs:range bito:ObservedExecution ;
                         rdfs:comment "Links a scenario to its observed execution evidence context."@en ;
                         rdfs:isDefinedBy <https://w3id.org/bito> ;
                         rdfs:label "has observed execution"@en ;
                         bito:sourceOntology <https://w3id.org/bito> ;
                         bito:sourceTermPage bito:hasObservedExecution .


###  https://w3id.org/bito#hasObservedSourceState
bito:hasObservedSourceState rdf:type owl:ObjectProperty ;
                           owl:inverseOf bito:isObservedSourceStateOf ;
                           rdfs:domain bito:ObservedStateChange ;
                           rdfs:range saref:State ;
                           rdfs:comment "Links an observed state change to its observed source state."@en ;
                           rdfs:isDefinedBy <https://w3id.org/bito> ;
                           rdfs:label "has observed source state"@en ;
                           bito:sourceOntology <https://w3id.org/bito> ;
                           bito:sourceTermPage bito:hasObservedSourceState .


###  https://w3id.org/bito#hasObservedStateChange
bito:hasObservedStateChange rdf:type owl:ObjectProperty ;
                           owl:inverseOf bito:isObservedStateChangeOf ;
                           rdfs:domain bito:ObservedExecution ;
                           rdfs:range bito:ObservedStateChange ;
                           rdfs:comment "Links an observed execution to an observed state change."@en ;
                           rdfs:isDefinedBy <https://w3id.org/bito> ;
                           rdfs:label "has observed state change"@en ;
                           bito:sourceOntology <https://w3id.org/bito> ;
                           bito:sourceTermPage bito:hasObservedStateChange .


###  https://w3id.org/bito#hasObservedTargetState
bito:hasObservedTargetState rdf:type owl:ObjectProperty ;
                           owl:inverseOf bito:isObservedTargetStateOf ;
                           rdfs:domain bito:ObservedStateChange ;
                           rdfs:range saref:State ;
                           rdfs:comment "Links an observed state change to its observed target state."@en ;
                           rdfs:isDefinedBy <https://w3id.org/bito> ;
                           rdfs:label "has observed target state"@en ;
                           bito:sourceOntology <https://w3id.org/bito> ;
                           bito:sourceTermPage bito:hasObservedTargetState .


###  https://w3id.org/bito#hasRelevantPowerSequence
bito:hasRelevantPowerSequence rdf:type owl:ObjectProperty ;
                             owl:inverseOf bito:isRelevantPowerSequenceOf ;
                             rdfs:domain bito:BehavioralElement ;
                             rdfs:range s4ener:PowerSequence ;
                             rdfs:comment "Links a behavioral element to the power sequence relevant for it."@en ;
                             rdfs:isDefinedBy <https://w3id.org/bito> ;
                             rdfs:label "has relevant power sequence"@en ;
                             bito:sourceOntology <https://w3id.org/bito> ;
                             bito:sourceTermPage bito:hasRelevantPowerSequence .


###  https://w3id.org/bito#hasScenario
bito:hasScenario rdf:type owl:ObjectProperty ;
                owl:inverseOf bito:isScenarioOf ;
                rdfs:domain bito:UseCase ;
                rdfs:range bito:Scenario ;
                rdfs:comment "Links a use case to a scenario that belongs to it."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "has scenario"@en ;
                bito:sourceOntology <https://w3id.org/bito> ;
                bito:sourceTermPage bito:hasScenario .


###  https://w3id.org/bito#hasSourceState
bito:hasSourceState rdf:type owl:ObjectProperty ;
                   owl:inverseOf bito:isSourceStateOf ;
                   rdfs:domain bito:ExpectedStateTransition ;
                   rdfs:range saref:State ;
                   rdfs:comment "Links an expected transition to its source state."@en ;
                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                   rdfs:label "has source state"@en ;
                   bito:sourceOntology <https://w3id.org/bito> ;
                   bito:sourceTermPage bito:hasSourceState .


###  https://w3id.org/bito#hasTargetState
bito:hasTargetState rdf:type owl:ObjectProperty ;
                   owl:inverseOf bito:isTargetStateOf ;
                   rdfs:domain bito:ExpectedStateTransition ;
                   rdfs:range saref:State ;
                   rdfs:comment "Links an expected transition to its target state."@en ;
                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                   rdfs:label "has target state"@en ;
                   bito:sourceOntology <https://w3id.org/bito> ;
                   bito:sourceTermPage bito:hasTargetState .


###  https://w3id.org/bito#hasTraceEvidence
bito:hasTraceEvidence rdf:type owl:ObjectProperty ;
                     owl:inverseOf bito:isTraceEvidenceOf ;
                     rdfs:domain bito:ObservedExecution ;
                     rdfs:range bito:TraceEvidence ;
                     rdfs:comment "Links an observed execution to the trace evidence used for validation."@en ;
                     rdfs:isDefinedBy <https://w3id.org/bito> ;
                     rdfs:label "has trace evidence"@en ;
                     bito:sourceOntology <https://w3id.org/bito> ;
                     bito:sourceTermPage bito:hasTraceEvidence .


###  https://w3id.org/bito#hasTriggeringInteraction
bito:hasTriggeringInteraction rdf:type owl:ObjectProperty ;
                             owl:inverseOf bito:isTriggeringInteractionOf ;
                             rdfs:domain bito:Scenario ;
                             rdfs:range bito:ObservedEvent ;
                             rdfs:comment "Links a scenario to the event, request, command, signal, or condition that initiates or influences behavior."@en ;
                             rdfs:isDefinedBy <https://w3id.org/bito> ;
                             rdfs:label "has triggering interaction"@en ;
                             bito:sourceOntology <https://w3id.org/bito> ;
                             bito:sourceTermPage bito:hasTriggeringInteraction .


###  https://w3id.org/bito#hasValidationResult
bito:hasValidationResult rdf:type owl:ObjectProperty ;
                        owl:inverseOf bito:isValidationResultOf ;
                        rdfs:domain bito:ObservedExecution ;
                        rdfs:range bito:ValidationResult ;
                        rdfs:comment "Links an observed execution to its validation result."@en ;
                        rdfs:isDefinedBy <https://w3id.org/bito> ;
                        rdfs:label "has validation result"@en ;
                        bito:sourceOntology <https://w3id.org/bito> ;
                        bito:sourceTermPage bito:hasValidationResult .


###  https://w3id.org/bito#hasVerdict
bito:hasVerdict rdf:type owl:ObjectProperty ;
               owl:inverseOf bito:isVerdictOf ;
               rdfs:domain bito:ValidationResult ;
               rdfs:range bito:ValidationVerdict ;
               rdfs:comment "Links a validation result to its verdict."@en ;
               rdfs:isDefinedBy <https://w3id.org/bito> ;
               rdfs:label "has verdict"@en ;
               bito:sourceOntology <https://w3id.org/bito> ;
               bito:sourceTermPage bito:hasVerdict .


###  https://w3id.org/bito#isAppliedBy
bito:isAppliedBy rdf:type owl:ObjectProperty ;
                rdfs:domain bito:BehavioralElement ;
                rdfs:range bito:BehavioralConstraint ;
                rdfs:comment "Specifies the behavioral constraint that applies to this behavioral element."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "Is Applied By"@en ;
                bito:sourceOntology <https://w3id.org/bito> ;
                bito:sourceTermPage bito:isAppliedBy .


###  https://w3id.org/bito#isBehavioralConstraintOf
bito:isBehavioralConstraintOf rdf:type owl:ObjectProperty ;
                             rdfs:domain bito:BehavioralConstraint ;
                             rdfs:range bito:Scenario ;
                             rdfs:comment "Specifies the scenario to which this behavioral constraint belongs."@en ;
                             rdfs:isDefinedBy <https://w3id.org/bito> ;
                             rdfs:label "Is Behavioral Constraint Of"@en ;
                             bito:sourceOntology <https://w3id.org/bito> ;
                             bito:sourceTermPage bito:isBehavioralConstraintOf .


###  https://w3id.org/bito#isComponentOf
bito:isComponentOf rdf:type owl:ObjectProperty ;
                  rdfs:domain bito:StructuralElement ;
                  rdfs:range bito:StructuralContainer ;
                  rdfs:comment "Links a structural element to the structural container it is part of, such as a slot to its power sequence."@en ;
                  rdfs:isDefinedBy <https://w3id.org/bito> ;
                  rdfs:label "Is Component Of"@en ;
                  bito:sourceOntology <https://w3id.org/bito> ;
                  bito:sourceTermPage bito:isComponentOf .


###  https://w3id.org/bito#isExpectedOperationalOutcomeOf
bito:isExpectedOperationalOutcomeOf rdf:type owl:ObjectProperty ;
                                   rdfs:domain bito:ExpectedOperationalOutcome ;
                                   rdfs:range bito:Scenario ;
                                   rdfs:comment "Specifies the scenario of which this expected operational outcome is a part."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                                   rdfs:label "Is Expected Operational Outcome Of"@en ;
                                   bito:sourceOntology <https://w3id.org/bito> ;
                                   bito:sourceTermPage bito:isExpectedOperationalOutcomeOf .


###  https://w3id.org/bito#isExpectedStateTransitionOf
bito:isExpectedStateTransitionOf rdf:type owl:ObjectProperty ;
                                rdfs:domain bito:ExpectedStateTransition ;
                                rdfs:range bito:Scenario ;
                                rdfs:comment "Specifies the scenario of which this expected state transition is a part."@en ;
                                rdfs:isDefinedBy <https://w3id.org/bito> ;
                                rdfs:label "Is Expected State Transition Of"@en ;
                                bito:sourceOntology <https://w3id.org/bito> ;
                                bito:sourceTermPage bito:isExpectedStateTransitionOf .


###  https://w3id.org/bito#isIUTOf
bito:isIUTOf rdf:type owl:ObjectProperty ;
            rdfs:domain saref:Device ;
            rdfs:range bito:Scenario ;
            rdfs:comment "Specifies the scenario in which this device serves as the implementation under test."@en ;
            rdfs:isDefinedBy <https://w3id.org/bito> ;
            rdfs:label "Is IUT Of"@en ;
            bito:sourceOntology <https://w3id.org/bito> ;
            bito:sourceTermPage bito:isIUTOf .


###  https://w3id.org/bito#isInteractingActorSystemOf
bito:isInteractingActorSystemOf rdf:type owl:ObjectProperty ;
                               rdfs:domain prov:Agent ;
                               rdfs:range bito:Scenario ;
                               rdfs:comment "Specifies the scenario in which this agent acts as the interacting actor or system."@en ;
                               rdfs:isDefinedBy <https://w3id.org/bito> ;
                               rdfs:label "Is Interacting Actor System Of"@en ;
                               bito:sourceOntology <https://w3id.org/bito> ;
                               bito:sourceTermPage bito:isInteractingActorSystemOf .


###  https://w3id.org/bito#isObservedEventOf
bito:isObservedEventOf rdf:type owl:ObjectProperty ;
                      rdfs:domain bito:ObservedEvent ;
                      rdfs:range bito:ObservedExecution ;
                      rdfs:comment "Specifies the observed execution in which this observed event was recorded."@en ;
                      rdfs:isDefinedBy <https://w3id.org/bito> ;
                      rdfs:label "Is Observed Event Of"@en ;
                      bito:sourceOntology <https://w3id.org/bito> ;
                      bito:sourceTermPage bito:isObservedEventOf .


###  https://w3id.org/bito#isObservedExecutionOf
bito:isObservedExecutionOf rdf:type owl:ObjectProperty ;
                          rdfs:domain bito:ObservedExecution ;
                          rdfs:range bito:Scenario ;
                          rdfs:comment "Specifies the scenario for which this observed execution serves as evidence."@en ;
                          rdfs:isDefinedBy <https://w3id.org/bito> ;
                          rdfs:label "Is Observed Execution Of"@en ;
                          bito:sourceOntology <https://w3id.org/bito> ;
                          bito:sourceTermPage bito:isObservedExecutionOf .


###  https://w3id.org/bito#isObservedFormerPreferredPowerSequenceOf
bito:isObservedFormerPreferredPowerSequenceOf rdf:type owl:ObjectProperty ;
                                             owl:inverseOf bito:observedFormerPreferredPowerSequence ;
                                             rdfs:domain s4ener:PowerSequence ;
                                             rdfs:range bito:TraceEvidence ;
                                             rdfs:comment "Specifies the trace evidence in which this power sequence is the former preferred power sequence."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/bito> ;
                                             rdfs:label "Is Observed Former Preferred Power Sequence Of"@en ;
                                             bito:sourceOntology <https://w3id.org/bito> ;
                                             bito:sourceTermPage bito:isObservedFormerPreferredPowerSequenceOf .


###  https://w3id.org/bito#isObservedOptionalPowerSequenceOf
bito:isObservedOptionalPowerSequenceOf rdf:type owl:ObjectProperty ;
                                      owl:inverseOf bito:observedOptionalPowerSequence ;
                                      rdfs:domain s4ener:PowerSequence ;
                                      rdfs:range bito:TraceEvidence ;
                                      rdfs:comment "Specifies the trace evidence in which this power sequence is the observed optional power sequence."@en ;
                                      rdfs:isDefinedBy <https://w3id.org/bito> ;
                                      rdfs:label "Is Observed Optional Power Sequence Of"@en ;
                                      bito:sourceOntology <https://w3id.org/bito> ;
                                      bito:sourceTermPage bito:isObservedOptionalPowerSequenceOf .


###  https://w3id.org/bito#isObservedPreferredPowerSequenceOf
bito:isObservedPreferredPowerSequenceOf rdf:type owl:ObjectProperty ;
                                       owl:inverseOf bito:observedPreferredPowerSequence ;
                                       rdfs:domain s4ener:PowerSequence ;
                                       rdfs:range bito:TraceEvidence ;
                                       rdfs:comment "Specifies the trace evidence in which this power sequence is the observed preferred power sequence."@en ;
                                       rdfs:isDefinedBy <https://w3id.org/bito> ;
                                       rdfs:label "Is Observed Preferred Power Sequence Of"@en ;
