bito:UseCaseFunction rdf:type owl:Class ;
                    rdfs:comment "Function used to realize a scenario-level information exchange."@en ;
                    rdfs:isDefinedBy <https://w3id.org/bito> ;
                    rdfs:label "Use case function"@en ;
                    bito:sourceOntology <https://w3id.org/bito> ;
                    bito:sourceTermPage bito:UseCaseFunction .


###  https://w3id.org/bito#ValidationResult
bito:ValidationResult rdf:type owl:Class ;
                     rdfs:comment "Result of assessing observed execution evidence against behavioral constraints."@en ;
                     rdfs:isDefinedBy <https://w3id.org/bito> ;
                     rdfs:label "Validation result"@en ;
                     bito:sourceOntology <https://w3id.org/bito> ;
                     bito:sourceTermPage bito:ValidationResult .


###  https://w3id.org/bito#ValidationVerdict
bito:ValidationVerdict rdf:type owl:Class ;
                      rdfs:comment "Verdict derived from available trace evidence."@en ;
                      rdfs:isDefinedBy <https://w3id.org/bito> ;
                      rdfs:label "Validation verdict"@en ;
                      bito:sourceOntology <https://w3id.org/bito> ;
                      bito:sourceTermPage bito:ValidationVerdict .


#################################################################
#    Individuals
#################################################################

###  https://saref.etsi.org/core/Watt
saref:Watt rdf:type owl:NamedIndividual ,
                    saref:PowerUnit ;
           rdfs:comment "Reused unit individual for power values expressed in watts."@en ;
           rdfs:isDefinedBy saref: ;
           rdfs:label "Watt"@en ;
           bito:sourceOntology saref: ;
           bito:sourceTermPage saref:Watt .


###  https://saref.etsi.org/saref4ener/Completed
s4ener:Completed rdf:type owl:NamedIndividual ,
                          s4ener:PowerSequenceState ;
                 rdfs:comment "Reused state for a completed power sequence."@en ;
                 rdfs:isDefinedBy s4ener: ;
                 rdfs:label "Completed"@en ;
                 bito:sourceOntology s4ener: ;
                 bito:sourceTermPage s4ener:Completed .


###  https://saref.etsi.org/saref4ener/Inactive
s4ener:Inactive rdf:type owl:NamedIndividual ,
                         s4ener:PowerSequenceState ;
                rdfs:comment "Reused state for an inactive power sequence."@en ;
                rdfs:isDefinedBy s4ener: ;
                rdfs:label "Inactive"@en ;
                bito:sourceOntology s4ener: ;
                bito:sourceTermPage s4ener:Inactive .


###  https://saref.etsi.org/saref4ener/Scheduled
s4ener:Scheduled rdf:type owl:NamedIndividual ,
                          s4ener:PowerSequenceState ;
                 rdfs:comment "Reused state for a scheduled power sequence."@en ;
                 rdfs:isDefinedBy s4ener: ;
                 rdfs:label "Scheduled"@en ;
                 bito:sourceOntology s4ener: ;
                 bito:sourceTermPage s4ener:Scheduled .


###  https://w3id.org/bito#FAIL
bito:FAIL rdf:type owl:NamedIndividual ,
                  bito:ValidationVerdict ;
         rdfs:comment "Verdict indicating that the available trace evidence violates at least one applicable validation condition."@en ;
         rdfs:isDefinedBy <https://w3id.org/bito> ;
         rdfs:label "FAIL"@en ;
         bito:sourceOntology <https://w3id.org/bito> ;
         bito:sourceTermPage bito:FAIL .


###  https://w3id.org/bito#INCONCLUSIVE
bito:INCONCLUSIVE rdf:type owl:NamedIndividual ,
                          bito:ValidationVerdict ;
                 rdfs:comment "Verdict indicating that the available trace evidence is insufficient or ambiguous."@en ;
                 rdfs:isDefinedBy <https://w3id.org/bito> ;
                 rdfs:label "INCONCLUSIVE"@en ;
                 bito:sourceOntology <https://w3id.org/bito> ;
                 bito:sourceTermPage bito:INCONCLUSIVE .


###  https://w3id.org/bito#PASS
bito:PASS rdf:type owl:NamedIndividual ,
                  bito:ValidationVerdict ;
         rdfs:comment "Verdict indicating that the available trace evidence satisfies the applicable validation conditions."@en ;
         rdfs:isDefinedBy <https://w3id.org/bito> ;
         rdfs:label "PASS"@en ;
         bito:sourceOntology <https://w3id.org/bito> ;
         bito:sourceTermPage bito:PASS .


###  https://w3id.org/bito/example/flexible-start#AlternativesGroup_1
ex:AlternativesGroup_1 rdf:type owl:NamedIndividual ,
                                s4ener:AlternativesGroup ;
                       saref:consistsOf ex:PowerSequence_44 ,
                                        ex:PowerSequence_45 ;
                       s4ener:belongsTo ex:PowerProfile_000000000001 ;
                       saref:hasIdentifier 1 ;
                       rdfs:label "Alternatives group 1"@en .


###  https://w3id.org/bito/example/flexible-start#CCM
ex:CCM rdf:type owl:NamedIndividual ,
                prov:Agent ;
       rdfs:comment "Customer Connectivity Manager used as interacting actor system in the Flexible Start validation instances."@en ;
       rdfs:label "CCM"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S1_PlanStatus
ex:Constraint_S1_PlanStatus rdf:type owl:NamedIndividual ,
                                     bito:BehavioralConstraint ,
                                     bito:OutcomeConstraint ;
                            bito:appliesTo ex:Outcome_S1_ValidPlan ;
                            rdfs:comment "Scenario 1 observed plan status is valid."@en ;
                            rdfs:label "S1 plan status constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S1_PlanStructure
ex:Constraint_S1_PlanStructure rdf:type owl:NamedIndividual ,
                                        bito:BehavioralConstraint ,
                                        bito:StateConstraint ;
                               bito:appliesTo ex:Transition_S1_PlanAvailable ;
                               rdfs:comment "Scenario 1 plan contains the expected alternatives group and power sequences."@en ;
                               rdfs:label "S1 plan structure constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S2_RequestAccepted
ex:Constraint_S2_RequestAccepted rdf:type owl:NamedIndividual ,
                                          bito:BehavioralConstraint ,
                                          bito:TriggerConstraint ;
                                 bito:appliesTo ex:Event_S2_ShiftRequest ;
                                 rdfs:comment "Scenario 2 shift request is accepted."@en ;
                                 rdfs:label "S2 request accepted constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S2_RunCompleted
ex:Constraint_S2_RunCompleted rdf:type owl:NamedIndividual ,
                                       bito:BehavioralConstraint ,
                                       bito:OutcomeConstraint ;
                              bito:appliesTo ex:Outcome_S2_PreferredSequenceShifted ;
                              rdfs:comment "Scenario 2 observed run status is completed."@en ;
                              rdfs:label "S2 run completed constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S2_StartTimeUpdated
ex:Constraint_S2_StartTimeUpdated rdf:type owl:NamedIndividual ,
                                           bito:BehavioralConstraint ,
                                           bito:TimingConstraint ;
                                  bito:appliesTo ex:Transition_S2_PreferredSequenceShifted ;
                                  rdfs:comment "Scenario 2 preferred sequence start time is updated to the requested value."@en ;
                                  rdfs:label "S2 start time updated constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S3_FormerPreferredInactive
ex:Constraint_S3_FormerPreferredInactive rdf:type owl:NamedIndividual ,
                                                  bito:BehavioralConstraint ,
                                                  bito:TransitionConstraint ;
                                         bito:appliesTo ex:Transition_S3_FormerPreferredInactive ;
                                         rdfs:comment "Scenario 3 former preferred sequence becomes inactive."@en ;
                                         rdfs:label "S3 former preferred inactive constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S3_RequestAccepted
ex:Constraint_S3_RequestAccepted rdf:type owl:NamedIndividual ,
                                          bito:BehavioralConstraint ,
                                          bito:TriggerConstraint ;
                                 bito:appliesTo ex:Event_S3_SelectRequest ;
                                 rdfs:comment "Scenario 3 selection request is accepted."@en ;
                                 rdfs:label "S3 request accepted constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S3_RunCompleted
ex:Constraint_S3_RunCompleted rdf:type owl:NamedIndividual ,
                                       bito:BehavioralConstraint ,
                                       bito:OutcomeConstraint ;
                              bito:appliesTo ex:Outcome_S3_AlternativeSequenceSelected ;
                              rdfs:comment "Scenario 3 observed run status is completed."@en ;
                              rdfs:label "S3 run completed constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Constraint_S3_SelectedSequenceScheduled
ex:Constraint_S3_SelectedSequenceScheduled rdf:type owl:NamedIndividual ,
                                                    bito:BehavioralConstraint ,
                                                    bito:TransitionConstraint ;
                                           bito:appliesTo ex:Transition_S3_SelectedSequenceScheduled ;
                                           rdfs:comment "Scenario 3 selected sequence becomes scheduled."@en ;
                                           rdfs:label "S3 selected sequence scheduled constraint"@en .


###  https://w3id.org/bito/example/flexible-start#Dishwasher_000000000001
ex:Dishwasher_000000000001 rdf:type owl:NamedIndividual ,
                                    saref:Appliance ;
                           saref:consistsOf ex:PowerProfile_000000000001 ;
                           saref:hasIdentifier "000000000001" ;
                           bito:entityId 0 ;
                           bito:entityType "Dishwasher" ;
                           rdfs:label "Dishwasher 000000000001"@en .


###  https://w3id.org/bito/example/flexible-start#Event_S1_PlanObservation
ex:Event_S1_PlanObservation rdf:type owl:NamedIndividual ,
                                     bito:ObservedEvent ;
                            bito:eventOrderIndex 1 ;
                            bito:interactionEndpoint "GET /v1/features/powerSequence" ;
                            bito:observedAt "2025-07-15T09:00:00+00:00"^^xsd:dateTime ;
                            bito:observedInteractionKind "plan observation" ;
                            rdfs:label "Scenario 1 plan observation"@en .


###  https://w3id.org/bito/example/flexible-start#Event_S2_ShiftRequest
ex:Event_S2_ShiftRequest rdf:type owl:NamedIndividual ,
                                  bito:ObservedEvent ;
                         bito:requestedPowerSequence ex:PowerSequence_44 ;
                         bito:acceptanceOutcome "accepted" ;
                         bito:acceptedAt "2025-07-15T09:30:02+00:00"^^xsd:dateTime ;
                         bito:eventOrderIndex 1 ;
                         bito:interactionEndpoint "POST /v1/usecaseInterfaces/flexibleStartForWhiteGoods/v1" ;
                         bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                         bito:observedExecutionStart "2025-07-15T11:00:20+00:00"^^xsd:dateTime ;
                         bito:observedInteractionKind "preferred sequence shift request" ;
                         bito:observedPlanUpdatedAt "2025-07-15T09:30:03+00:00"^^xsd:dateTime ;
                         bito:requestTimestamp "2025-07-15T09:30:00+00:00"^^xsd:dateTime ;
                         bito:requestedStartTime "2025-07-15T11:00:00+00:00"^^xsd:dateTime ;
                         rdfs:label "Scenario 2 shift request"@en .


###  https://w3id.org/bito/example/flexible-start#Event_S3_SelectRequest
ex:Event_S3_SelectRequest rdf:type owl:NamedIndividual ,
                                   bito:ObservedEvent ;
                          bito:requestedPowerSequence ex:PowerSequence_45 ;
                          bito:acceptanceOutcome "accepted" ;
                          bito:acceptedAt "2025-07-15T10:45:02+00:00"^^xsd:dateTime ;
                          bito:eventOrderIndex 1 ;
                          bito:interactionEndpoint "POST /v1/usecaseInterfaces/flexibleStartForWhiteGoods/v1" ;
                          bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                          bito:observedExecutionStart "2025-07-15T12:00:20+00:00"^^xsd:dateTime ;
                          bito:observedInteractionKind "alternative sequence selection request" ;
                          bito:observedPlanUpdatedAt "2025-07-15T10:45:04+00:00"^^xsd:dateTime ;
                          bito:requestTimestamp "2025-07-15T10:45:00+00:00"^^xsd:dateTime ;
                          bito:requestedStartTime "2025-07-15T12:00:00+00:00"^^xsd:dateTime ;
                          rdfs:label "Scenario 3 select request"@en .


###  https://w3id.org/bito/example/flexible-start#Execution_S1
ex:Execution_S1 rdf:type owl:NamedIndividual ,
                         bito:ObservedExecution ;
                bito:hasObservedEvent ex:Event_S1_PlanObservation ;
                bito:hasTraceEvidence ex:TraceEvidence_S1 ;
                bito:hasValidationResult ex:ValidationResult_S1 ;
                rdfs:label "Scenario 1 observed execution"@en .


###  https://w3id.org/bito/example/flexible-start#Execution_S2
ex:Execution_S2 rdf:type owl:NamedIndividual ,
                         bito:ObservedExecution ;
                bito:hasObservedEvent ex:Event_S2_ShiftRequest ;
                bito:hasObservedStateChange ex:ObservedStateChange_S2_Sequence44Scheduled ;
                bito:hasTraceEvidence ex:TraceEvidence_S2 ;
                bito:hasValidationResult ex:ValidationResult_S2 ;
                bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                bito:observedExecutionStart "2025-07-15T11:00:20+00:00"^^xsd:dateTime ;
                rdfs:label "Scenario 2 observed execution"@en .


###  https://w3id.org/bito/example/flexible-start#Execution_S3
ex:Execution_S3 rdf:type owl:NamedIndividual ,
                         bito:ObservedExecution ;
                bito:hasObservedEvent ex:Event_S3_SelectRequest ;
                bito:hasObservedStateChange ex:ObservedStateChange_S3_Sequence44Inactive ,
                                           ex:ObservedStateChange_S3_Sequence45Scheduled ;
                bito:hasTraceEvidence ex:TraceEvidence_S3 ;
                bito:hasValidationResult ex:ValidationResult_S3 ;
                bito:observedExecutionEnd "2025-07-15T13:29:40+00:00"^^xsd:dateTime ;
                bito:observedExecutionStart "2025-07-15T12:00:20+00:00"^^xsd:dateTime ;
                rdfs:label "Scenario 3 observed execution"@en .


###  https://w3id.org/bito/example/flexible-start#FlexibleStartUseCase
ex:FlexibleStartUseCase rdf:type owl:NamedIndividual ,
                                 bito:UseCase ;
                        bito:hasScenario ex:Scenario1 ,
                                        ex:Scenario2 ,
                                        ex:Scenario3 ;
                        bito:useCaseName "flexibleStartForWhiteGoods" ;
                        bito:useCaseVersion "1.0.0" ;
                        rdfs:comment "Example use case used for validating the behavioral ontology with Scenarios 1, 2, and 3."@en ;
                        rdfs:label "Flexible Start use case"@en .


###  https://w3id.org/bito/example/flexible-start#ObservedStateChange_S2_Sequence44Scheduled
ex:ObservedStateChange_S2_Sequence44Scheduled rdf:type owl:NamedIndividual ,
                                                       bito:ObservedStateChange ;
                                              bito:hasObservedSourceState s4ener:Scheduled ;
                                              bito:hasObservedTargetState s4ener:Scheduled ;
                                              bito:hasRelevantPowerSequence ex:PowerSequence_44 ;
                                              rdfs:label "Scenario 2 sequence 44 remains scheduled"@en .


###  https://w3id.org/bito/example/flexible-start#ObservedStateChange_S3_Sequence44Inactive
ex:ObservedStateChange_S3_Sequence44Inactive rdf:type owl:NamedIndividual ,
                                                      bito:ObservedStateChange ;
                                             bito:hasObservedSourceState s4ener:Scheduled ;
                                             bito:hasObservedTargetState s4ener:Inactive ;
                                             bito:hasRelevantPowerSequence ex:PowerSequence_44 ;
                                             rdfs:label "Scenario 3 sequence 44 becomes inactive"@en .


###  https://w3id.org/bito/example/flexible-start#ObservedStateChange_S3_Sequence45Scheduled
ex:ObservedStateChange_S3_Sequence45Scheduled rdf:type owl:NamedIndividual ,
                                                       bito:ObservedStateChange ;
                                              bito:hasObservedSourceState s4ener:Inactive ;
                                              bito:hasObservedTargetState s4ener:Scheduled ;
                                              bito:hasRelevantPowerSequence ex:PowerSequence_45 ;
                                              rdfs:label "Scenario 3 sequence 45 becomes scheduled"@en .


###  https://w3id.org/bito/example/flexible-start#Outcome_S1_ValidPlan
ex:Outcome_S1_ValidPlan rdf:type owl:NamedIndividual ,
                                 bito:ExpectedOperationalOutcome ;
                        rdfs:label "Scenario 1 valid plan outcome"@en .


###  https://w3id.org/bito/example/flexible-start#Outcome_S2_PreferredSequenceShifted
ex:Outcome_S2_PreferredSequenceShifted rdf:type owl:NamedIndividual ,
                                                bito:ExpectedOperationalOutcome ;
                                       rdfs:label "Scenario 2 preferred sequence shifted outcome"@en .


###  https://w3id.org/bito/example/flexible-start#Outcome_S3_AlternativeSequenceSelected
ex:Outcome_S3_AlternativeSequenceSelected rdf:type owl:NamedIndividual ,
                                                   bito:ExpectedOperationalOutcome ;
                                          rdfs:label "Scenario 3 alternative sequence selected outcome"@en .


###  https://w3id.org/bito/example/flexible-start#PowerProfile_000000000001
ex:PowerProfile_000000000001 rdf:type owl:NamedIndividual ,
                                      s4ener:PowerProfile ;
                             saref:consistsOf ex:AlternativesGroup_1 ;
                             s4ener:nodeRemoteControllable "true"^^xsd:boolean ;
                             s4ener:supportsReselection "true"^^xsd:boolean ;
                             rdfs:label "Power profile 000000000001"@en .


###  https://w3id.org/bito/example/flexible-start#PowerSequence_44
ex:PowerSequence_44 rdf:type owl:NamedIndividual ,
                             s4ener:PowerSequence ;
                    saref:consistsOf ex:Slot_44_0 ,
                                     ex:Slot_44_1 ,
                                     ex:Slot_44_2 ,
                                     ex:Slot_44_3 ,
                                     ex:Slot_44_4 ,
                                     ex:Slot_44_5 ,
                                     ex:Slot_44_6 ,
                                     ex:Slot_44_7 ,
                                     ex:Slot_44_8 ,
                                     ex:Slot_44_9 ;
                    s4ener:belongsTo ex:AlternativesGroup_1 ;
                    saref:hasIdentifier 44 ;
                    s4ener:hasEarliestStartTime "2025-07-15T08:00:00+00:00"^^xsd:dateTime ;
                    s4ener:hasLatestEndTime "2025-07-15T14:30:00+00:00"^^xsd:dateTime ;
                    s4ener:isPausable "false"^^xsd:boolean ;
                    s4ener:isStoppable "false"^^xsd:boolean ;
                    s4ener:sequenceRemoteControllable "true"^^xsd:boolean ;
                    rdfs:label "Power sequence 44"@en .


###  https://w3id.org/bito/example/flexible-start#PowerSequence_45
ex:PowerSequence_45 rdf:type owl:NamedIndividual ,
                             s4ener:PowerSequence ;
                    saref:consistsOf ex:Slot_45_0 ,
                                     ex:Slot_45_1 ,
                                     ex:Slot_45_2 ;
                    s4ener:belongsTo ex:AlternativesGroup_1 ;
                    saref:hasIdentifier 45 ;
                    s4ener:hasEarliestStartTime "2025-07-15T08:00:00+00:00"^^xsd:dateTime ;
                    s4ener:hasLatestEndTime "2025-07-15T14:30:00+00:00"^^xsd:dateTime ;
                    s4ener:isPausable "false"^^xsd:boolean ;
                    s4ener:isStoppable "false"^^xsd:boolean ;
                    s4ener:sequenceRemoteControllable "true"^^xsd:boolean ;
                    rdfs:label "Power sequence 45"@en .


###  https://w3id.org/bito/example/flexible-start#Scenario1
ex:Scenario1 rdf:type owl:NamedIndividual ,
                      bito:Scenario ;
             bito:hasBehavioralConstraint ex:Constraint_S1_PlanStatus ,
                                         ex:Constraint_S1_PlanStructure ;
             bito:hasExpectedOperationalOutcome ex:Outcome_S1_ValidPlan ;
             bito:hasExpectedStateTransition ex:Transition_S1_PlanAvailable ;
             bito:hasIUT ex:Dishwasher_000000000001 ;
             bito:hasInteractingActorSystem ex:CCM ;
             bito:hasObservedExecution ex:Execution_S1 ;
             bito:hasTriggeringInteraction ex:Event_S1_PlanObservation ;
             bito:isScenarioOf ex:FlexibleStartUseCase ;
             bito:realizedByUseCaseFunction ex:UCF_Plan_With_Power_Sequences ;
             bito:scenarioName "Announcement of plan" ;
             bito:scenarioNumber 1 ;
             rdfs:label "Scenario 1"@en .


###  https://w3id.org/bito/example/flexible-start#Scenario2
ex:Scenario2 rdf:type owl:NamedIndividual ,
                      bito:Scenario ;
             bito:hasBehavioralConstraint ex:Constraint_S2_RequestAccepted ,
                                         ex:Constraint_S2_RunCompleted ,
                                         ex:Constraint_S2_StartTimeUpdated ;
             bito:hasExpectedOperationalOutcome ex:Outcome_S2_PreferredSequenceShifted ;
             bito:hasExpectedStateTransition ex:Transition_S2_PreferredSequenceShifted ;
             bito:hasIUT ex:Dishwasher_000000000001 ;
             bito:hasInteractingActorSystem ex:CCM ;
             bito:hasObservedExecution ex:Execution_S2 ;
             bito:hasTriggeringInteraction ex:Event_S2_ShiftRequest ;
             bito:isScenarioOf ex:FlexibleStartUseCase ;
             bito:realizedByUseCaseFunction ex:UCF_Shift_Preferred_Power_Sequence ;
             bito:scenarioName "Shift preferred power sequence" ;
             bito:scenarioNumber 2 ;
             rdfs:label "Scenario 2"@en .


###  https://w3id.org/bito/example/flexible-start#Scenario3
ex:Scenario3 rdf:type owl:NamedIndividual ,
                      bito:Scenario ;
             bito:hasBehavioralConstraint ex:Constraint_S3_FormerPreferredInactive ,
                                         ex:Constraint_S3_RequestAccepted ,
                                         ex:Constraint_S3_RunCompleted ,
                                         ex:Constraint_S3_SelectedSequenceScheduled ;
             bito:hasExpectedOperationalOutcome ex:Outcome_S3_AlternativeSequenceSelected ;
             bito:hasExpectedStateTransition ex:Transition_S3_FormerPreferredInactive ,
                                            ex:Transition_S3_SelectedSequenceScheduled ;
             bito:hasIUT ex:Dishwasher_000000000001 ;
             bito:hasInteractingActorSystem ex:CCM ;
             bito:hasObservedExecution ex:Execution_S3 ;
             bito:hasTriggeringInteraction ex:Event_S3_SelectRequest ;
             bito:isScenarioOf ex:FlexibleStartUseCase ;
             bito:realizedByUseCaseFunction ex:UCF_Select_Power_Sequence ;
             bito:scenarioName "Select alternative power sequence" ;
             bito:scenarioNumber 3 ;
             rdfs:label "Scenario 3"@en .


