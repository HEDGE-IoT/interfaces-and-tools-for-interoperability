             saref:hasIdentifier 9 ;
             s4ener:hasDefaultDuration "PT15M"^^xsd:duration ;
             rdfs:label "Slot 44 9"@en .


###  https://w3id.org/bito/example/flexible-start#Slot_45_0
ex:Slot_45_0 rdf:type owl:NamedIndividual ,
                      s4ener:Slot ;
             s4ener:belongsTo ex:PowerSequence_45 ;
             saref:hasIdentifier 0 ;
             s4ener:hasDefaultDuration "PT30M"^^xsd:duration ;
             rdfs:label "Slot 45 0"@en .


###  https://w3id.org/bito/example/flexible-start#Slot_45_1
ex:Slot_45_1 rdf:type owl:NamedIndividual ,
                      s4ener:Slot ;
             s4ener:belongsTo ex:PowerSequence_45 ;
             saref:hasIdentifier 1 ;
             s4ener:hasDefaultDuration "PT30M"^^xsd:duration ;
             rdfs:label "Slot 45 1"@en .


###  https://w3id.org/bito/example/flexible-start#Slot_45_2
ex:Slot_45_2 rdf:type owl:NamedIndividual ,
                      s4ener:Slot ;
             s4ener:belongsTo ex:PowerSequence_45 ;
             saref:hasIdentifier 2 ;
