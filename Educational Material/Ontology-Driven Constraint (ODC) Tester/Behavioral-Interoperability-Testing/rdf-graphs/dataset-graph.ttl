ex:Scenario_3 a bito:Scenario;
  rdfs:label "Scenario 3 - Select Alternative Power Sequence";
  bito:hasIUT <https://w3id.org/bito/example/flexible-start/device/000000000001/entity/0>;
  bito:hasTriggeringInteraction <https://w3id.org/bito/example/flexible-start/event/scenario3/select-sequence/45>;
  bito:realizedByUseCaseFunction ex:UCF_Select_Power_Sequence;
  bito:scenarioNumber 3 .

ex:UCF_Select_Power_Sequence a bito:UseCaseFunction;
  rdfs:label "Select alternative power sequence";
  bito:ucfName "UCF_Select_Power_Sequence" .

ex:Watt a saref:PowerUnit, saref:UnitOfMeasure;
  rdfs:label "W" .

<https://w3id.org/bito/example/flexible-start/actor/SmartAppliance> a saref:Appliance,
    saref:Device;
  rdfs:label "SmartAppliance" .

<https://w3id.org/bito/example/flexible-start/alternatives-group/1> a s4ener:AlternativesGroup;
  saref:consistsOf <https://w3id.org/bito/example/flexible-start/power-sequence/44>,
    <https://w3id.org/bito/example/flexible-start/power-sequence/45>;
  saref:hasIdentifier 1 .

<https://w3id.org/bito/example/flexible-start/device/000000000001/entity/0> a saref:Appliance,
    saref:Device;
  saref:hasIdentifier "000000000001";
  bito:entityId 0;
  bito:entityType "Dishwasher" .

