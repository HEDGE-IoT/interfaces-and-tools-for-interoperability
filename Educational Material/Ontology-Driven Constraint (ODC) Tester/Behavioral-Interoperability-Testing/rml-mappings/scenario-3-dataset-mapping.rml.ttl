    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/bito/example/flexible-start/power-sequence/{data.sequenceId}/slot/{data.slotNumber}/value" ;
        rr:class saref:PropertyValue
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:hasValue ;
        rr:objectMap [ rml:reference "data.power.number" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:isMeasuredIn ;
        rr:objectMap [ rr:constant ex:Watt ]
    ] .

#################################################################
# 13. Watt unit resource
#################################################################

<#WattUnitMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$..response[?(@.featureObjType == 'powerTimeSlot')]"
    ] ;
    rr:subjectMap [
        rr:constant ex:Watt ;
        rr:class saref:UnitOfMeasure ;
        rr:class saref:PowerUnit
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:constant "W" ]
    ] .
