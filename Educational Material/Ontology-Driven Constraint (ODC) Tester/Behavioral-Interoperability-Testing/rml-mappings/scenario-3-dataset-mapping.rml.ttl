#################################################################
# 8. Base power sequence resources
#################################################################

<#PowerSequenceBaseMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$..response[?(@.featureObjType == 'powerSequence')]"
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/bito/example/flexible-start/power-sequence/{data.sequenceId}" ;
        rr:class s4ener:PowerSequence
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:hasIdentifier ;
        rr:objectMap [ rml:reference "data.sequenceId" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:hasDescription ;
        rr:objectMap [ rml:reference "data.description" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:sequenceRemoteControllable ;
        rr:objectMap [ rml:reference "data.sequenceRemoteControllable" ; rr:datatype xsd:boolean ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:isPausable ;
        rr:objectMap [ rml:reference "data.isPausable" ; rr:datatype xsd:boolean ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:isStoppable ;
        rr:objectMap [ rml:reference "data.isStoppable" ; rr:datatype xsd:boolean ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasValueSource ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/value-source/{data.valueSource}" ;
            rr:termType rr:IRI
        ]
    ] .

<#ValueSourceMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$..response[?(@.featureObjType == 'powerSequence' && @.data.valueSource)]"
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/bito/example/flexible-start/value-source/{data.valueSource}" ;
        rr:class prov:Entity
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "data.valueSource" ]
    ] .

#################################################################
# 9. Initial sequence state snapshots - before Scenario 3 request
#################################################################

<#InitialScheduledStateSnapshotMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[4].response[?(@.featureObjType == 'powerSequence' && @.data.state == 'scheduled')]"
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/bito/example/flexible-start/snapshot/initial/sequence/{data.sequenceId}" ;
        rr:class bito:BehavioralElement
    ] ;
    rr:predicateObjectMap [
        rr:predicate prov:specializationOf ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/power-sequence/{data.sequenceId}" ;
            rr:termType rr:IRI
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
        rr:objectMap [ rr:constant "Initial plan state snapshot" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:hasState ;
        rr:objectMap [ rr:constant s4ener:Scheduled ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasStartTime ;
        rr:objectMap [ rml:reference "data.startTime" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasEndTime ;
        rr:objectMap [ rml:reference "data.endTime" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasEarliestStartTime ;
        rr:objectMap [ rml:reference "data.earliestStartTime" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasLatestEndTime ;
        rr:objectMap [ rml:reference "data.latestEndTime" ; rr:datatype xsd:dateTime ]
    ] .

