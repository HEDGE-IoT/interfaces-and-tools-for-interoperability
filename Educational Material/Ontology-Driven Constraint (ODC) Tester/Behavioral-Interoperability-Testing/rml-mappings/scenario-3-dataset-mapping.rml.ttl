    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:hasState ;
        rr:objectMap [ rr:constant s4ener:Inactive ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasEarliestStartTime ;
        rr:objectMap [ rml:reference "data.earliestStartTime" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4ener:hasLatestEndTime ;
        rr:objectMap [ rml:reference "data.latestEndTime" ; rr:datatype xsd:dateTime ]
    ] .

#################################################################
# 10. Scenario 3 request event
#################################################################

<#Scenario3RequestEventMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[?(@.body.data.selectPowerSequence)]"
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/bito/example/flexible-start/event/scenario3/select-sequence/{body.data.selectPowerSequence.sequenceId}" ;
        rr:class bito:ObservedEvent ;
        rr:class prov:Activity
    ] ;
    rr:predicateObjectMap [
        rr:predicate bito:requestedPowerSequence ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/power-sequence/{body.data.selectPowerSequence.sequenceId}" ;
            rr:termType rr:IRI
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate bito:requestedStartTime ;
        rr:objectMap [
            rml:reference "body.data.selectPowerSequence.startTime" ;
            rr:datatype xsd:dateTime
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate bito:hasIUT ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/device/{body.deviceId}/entity/{body.entityId}" ;
            rr:termType rr:IRI
        ]
    ] .

<#Scenario3TriggerLinkMapping>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "C:/Users/tareqc/Downloads/Behavioral Testing/input/simulated_dataset_scenario_3.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[?(@.body.data.selectPowerSequence)]"
    ] ;
    rr:subjectMap [
        rr:constant ex:Scenario_3 ;
        rr:class bito:Scenario
    ] ;
    rr:predicateObjectMap [
        rr:predicate bito:hasTriggeringInteraction ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/event/scenario3/select-sequence/{body.data.selectPowerSequence.sequenceId}" ;
            rr:termType rr:IRI
        ]
    ] .

