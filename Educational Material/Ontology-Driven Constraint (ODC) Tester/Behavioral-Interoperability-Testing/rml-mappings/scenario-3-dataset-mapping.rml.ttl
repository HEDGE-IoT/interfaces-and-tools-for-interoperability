    ] ;
    rr:predicateObjectMap [
        rr:predicate prov:specializationOf ;
        rr:objectMap [
            rr:template "https://w3id.org/bito/example/flexible-start/power-sequence/{data.sequenceId}" ;
            rr:termType rr:IRI
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dcterms:description ;
