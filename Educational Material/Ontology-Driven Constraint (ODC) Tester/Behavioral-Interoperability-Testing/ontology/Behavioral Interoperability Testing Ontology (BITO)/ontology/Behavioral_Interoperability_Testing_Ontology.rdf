<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bito#"
     xml:base="https://w3id.org/bito"
     xmlns:ex="https://w3id.org/bito/example/flexible-start#"
     xmlns:bito="https://w3id.org/bito#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:saref="https://saref.etsi.org/core/"
     xmlns:s4ener="https://saref.etsi.org/saref4ener/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/bito">
        <owl:versionIRI rdf:resource="https://w3id.org/bito/1.0.0"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-20</dcterms:created>
        <dcterms:creator xml:lang="en">Cornelis Bouter (TNO)</dcterms:creator>
        <dcterms:creator xml:lang="en">Laura Daniele (TNO)</dcterms:creator>
        <dcterms:creator xml:lang="en">Tareq Md Rabiul Hossain Chy (Trialog)</dcterms:creator>
        <dcterms:description xml:lang="en">Ontology for representing use cases, scenarios, expected behavior, observed execution evidence, constraints, validation results, and verdicts for ontology-driven behavioral validation.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified>2026-05-29</dcterms:modified>
        <dcterms:title xml:lang="en">Behavioral Core Ontology</dcterms:title>
        <vann:preferredNamespacePrefix xml:lang="en">bito</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/bito#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">It contains the behavioral vocabulary, selected reused ontology terms, and instances.</rdfs:comment>
        <owl:versionInfo xml:lang="en">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- https://w3id.org/bito#sourceOntology -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/bito#sourceOntology">
        <rdfs:comment xml:lang="en">Ontology or vocabulary from which the term is reused or in which the term is defined.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">source ontology</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#sourceOntology"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/bito#sourceTermPage -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/bito#sourceTermPage">
        <rdfs:comment xml:lang="en">Term IRI or reference page for the class, property, or individual.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">source term page</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#sourceTermPage"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://saref.etsi.org/core/consistsOf -->

    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/consistsOf">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isComponentOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#StructuralContainer"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#StructuralElement"/>
        <rdfs:comment xml:lang="en">Reused to connect power profiles to alternatives groups, alternatives groups to power sequences, and power sequences to slots.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">consists of</rdfs:label>
        <sourceOntology rdf:resource="https://saref.etsi.org/core/"/>
        <sourceTermPage rdf:resource="https://saref.etsi.org/core/consistsOf"/>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/core/hasState -->

    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/hasState">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isStateOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#BehavioralElement"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:comment xml:lang="en">Reused to connect an entity to a state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">has state</rdfs:label>
        <sourceOntology rdf:resource="https://saref.etsi.org/core/"/>
        <sourceTermPage rdf:resource="https://saref.etsi.org/core/hasState"/>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/core/isMeasuredIn -->

    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/isMeasuredIn">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isUnitOfMeasureFor"/>
        <rdfs:domain rdf:resource="https://saref.etsi.org/core/PropertyValue"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment xml:lang="en">Reused to connect a value to its unit of measure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">is measured in</rdfs:label>
        <sourceOntology rdf:resource="https://saref.etsi.org/core/"/>
        <sourceTermPage rdf:resource="https://saref.etsi.org/core/isMeasuredIn"/>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4ener/belongsTo -->

    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4ener/belongsTo">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#hasBelongingElement"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#StructuralElement"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#StructuralContainer"/>
        <rdfs:comment xml:lang="en">Reused to connect slots, power sequences, alternatives groups, and power profiles to their containing element.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4ener/"/>
        <rdfs:label xml:lang="en">belongs to</rdfs:label>
        <sourceOntology rdf:resource="https://saref.etsi.org/saref4ener/"/>
        <sourceTermPage rdf:resource="https://saref.etsi.org/saref4ener/belongsTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#appliesTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#appliesTo">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isAppliedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#BehavioralConstraint"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#BehavioralElement"/>
        <rdfs:comment xml:lang="en">Links a behavioral constraint to the behavioral element it constrains.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">applies to</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#appliesTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#basedOnTraceEvidence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#basedOnTraceEvidence">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isTraceEvidenceBasisOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ValidationResult"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#TraceEvidence"/>
        <rdfs:comment xml:lang="en">Links a validation result to the trace evidence used to derive it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">based on trace evidence</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#basedOnTraceEvidence"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasBehavioralConstraint -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasBehavioralConstraint">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isBehavioralConstraintOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#BehavioralConstraint"/>
        <rdfs:comment xml:lang="en">Links a scenario to an applicable behavioral constraint.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has behavioral constraint</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasBehavioralConstraint"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasBelongingElement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasBelongingElement">
        <rdfs:domain rdf:resource="https://w3id.org/bito#StructuralContainer"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#StructuralElement"/>
        <rdfs:comment xml:lang="en">Links a structural container to a structural element it directly contains, such as a power sequence to its slots.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">Has Belonging Element</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasBelongingElement"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasExpectedOperationalOutcome -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasExpectedOperationalOutcome">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isExpectedOperationalOutcomeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#ExpectedOperationalOutcome"/>
        <rdfs:comment xml:lang="en">Links a scenario to the outcome expected from valid execution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has expected operational outcome</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasExpectedOperationalOutcome"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasExpectedStateTransition -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasExpectedStateTransition">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isExpectedStateTransitionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#ExpectedStateTransition"/>
        <rdfs:comment xml:lang="en">Links a scenario to an expected state transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has expected state transition</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasExpectedStateTransition"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasIUT -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasIUT">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isIUTOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/Device"/>
        <rdfs:comment xml:lang="en">Links a scenario to the implementation under test.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has IUT</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasIUT"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasInteractingActorSystem -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasInteractingActorSystem">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isInteractingActorSystemOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Links a scenario to the external actor or system interacting with the IUT.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has interacting actor system</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasInteractingActorSystem"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasObservedEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasObservedEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isObservedEventOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ObservedExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#ObservedEvent"/>
        <rdfs:comment xml:lang="en">Links an observed execution to an observed event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has observed event</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasObservedEvent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasObservedExecution -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasObservedExecution">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isObservedExecutionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#ObservedExecution"/>
        <rdfs:comment xml:lang="en">Links a scenario to its observed execution evidence context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has observed execution</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasObservedExecution"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasObservedSourceState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasObservedSourceState">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isObservedSourceStateOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ObservedStateChange"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:comment xml:lang="en">Links an observed state change to its observed source state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has observed source state</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasObservedSourceState"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasObservedStateChange -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasObservedStateChange">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isObservedStateChangeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ObservedExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#ObservedStateChange"/>
        <rdfs:comment xml:lang="en">Links an observed execution to an observed state change.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has observed state change</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasObservedStateChange"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasObservedTargetState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasObservedTargetState">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isObservedTargetStateOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ObservedStateChange"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:comment xml:lang="en">Links an observed state change to its observed target state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has observed target state</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasObservedTargetState"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasRelevantPowerSequence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasRelevantPowerSequence">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isRelevantPowerSequenceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#BehavioralElement"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4ener/PowerSequence"/>
        <rdfs:comment xml:lang="en">Links a behavioral element to the power sequence relevant for it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has relevant power sequence</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasRelevantPowerSequence"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasScenario -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasScenario">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isScenarioOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#UseCase"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#Scenario"/>
        <rdfs:comment xml:lang="en">Links a use case to a scenario that belongs to it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has scenario</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasScenario"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasSourceState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasSourceState">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isSourceStateOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ExpectedStateTransition"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:comment xml:lang="en">Links an expected transition to its source state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has source state</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasSourceState"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasTargetState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasTargetState">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isTargetStateOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ExpectedStateTransition"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/State"/>
        <rdfs:comment xml:lang="en">Links an expected transition to its target state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has target state</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasTargetState"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasTraceEvidence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasTraceEvidence">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isTraceEvidenceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/bito#ObservedExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/bito#TraceEvidence"/>
        <rdfs:comment xml:lang="en">Links an observed execution to the trace evidence used for validation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/bito"/>
        <rdfs:label xml:lang="en">has trace evidence</rdfs:label>
        <sourceOntology rdf:resource="https://w3id.org/bito"/>
        <sourceTermPage rdf:resource="https://w3id.org/bito#hasTraceEvidence"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bito#hasTriggeringInteraction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bito#hasTriggeringInteraction">
        <owl:inverseOf rdf:resource="https://w3id.org/bito#isTriggeringInteractionOf"/>
