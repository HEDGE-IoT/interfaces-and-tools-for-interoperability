  {
    "@id": "https://w3id.org/bito",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-05-20"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "Cornelis Bouter (TNO)"
      },
      {
        "@language": "en",
        "@value": "Laura Daniele (TNO)"
      },
      {
        "@language": "en",
        "@value": "Tareq Md Rabiul Hossain Chy (Trialog)"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Ontology for representing use cases, scenarios, expected behavior, observed execution evidence, constraints, validation results, and verdicts for ontology-driven behavioral validation."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-06-03"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Behavioral Interoperability Testing Ontology (BITO)"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@language": "en",
        "@value": "bito"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/bito#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "It contains the behavioral vocabulary, selected reused ontology terms, and instances."
      }
    ],
