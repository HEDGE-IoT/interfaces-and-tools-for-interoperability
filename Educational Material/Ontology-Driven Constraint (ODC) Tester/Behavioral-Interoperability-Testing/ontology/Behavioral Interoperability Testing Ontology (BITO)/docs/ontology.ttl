@prefix : <https://w3id.org/bito#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bito#> .

<https://w3id.org/bito> rdf:type owl:Ontology ;
                        owl:versionIRI <https://w3id.org/bito/1.0.0> ;
                        <http://purl.org/dc/terms/created> "2026-05-20"^^xsd:date ;
                        <http://purl.org/dc/terms/creator> "Cornelis Bouter (TNO)"@en ,
                                                           "Laura Daniele (TNO)"@en ,
                                                           "Tareq Md Rabiul Hossain Chy (Trialog)"@en ;
                        <http://purl.org/dc/terms/description> "Ontology for representing use cases, scenarios, expected behavior, observed execution evidence, constraints, validation results, and verdicts for ontology-driven behavioral validation."@en ;
                        <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                        <http://purl.org/dc/terms/modified> "2026-06-03"^^xsd:date ;
                        <http://purl.org/dc/terms/title> "Behavioral Interoperability Testing Ontology (BITO)"@en ;
                        <http://purl.org/vocab/vann/preferredNamespacePrefix> "bito"@en ;
                        <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/bito#" ;
                        rdfs:comment "It contains the behavioral vocabulary, selected reused ontology terms, and instances."@en ;
                        owl:versionInfo "1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  https://w3id.org/bito#sourceOntology
:sourceOntology rdf:type owl:AnnotationProperty ;
                rdfs:comment "Ontology or vocabulary from which the term is reused or in which the term is defined."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "source ontology"@en ;
                :sourceOntology <https://w3id.org/bito> ;
                :sourceTermPage :sourceOntology .


###  https://w3id.org/bito#sourceTermPage
:sourceTermPage rdf:type owl:AnnotationProperty ;
                rdfs:comment "Term IRI or reference page for the class, property, or individual."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "source term page"@en ;
                :sourceOntology <https://w3id.org/bito> ;
                :sourceTermPage :sourceTermPage .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://saref.etsi.org/core/consistsOf
<https://saref.etsi.org/core/consistsOf> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf :isComponentOf ;
                                         rdfs:domain :StructuralContainer ;
                                         rdfs:range :StructuralElement ;
                                         rdfs:comment "Reused to connect power profiles to alternatives groups, alternatives groups to power sequences, and power sequences to slots."@en ;
                                         rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                         rdfs:label "consists of"@en ;
                                         :sourceOntology <https://saref.etsi.org/core/> ;
                                         :sourceTermPage <https://saref.etsi.org/core/consistsOf> .


###  https://saref.etsi.org/core/hasState
<https://saref.etsi.org/core/hasState> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf :isStateOf ;
                                       rdfs:domain :BehavioralElement ;
                                       rdfs:range <https://saref.etsi.org/core/State> ;
                                       rdfs:comment "Reused to connect an entity to a state."@en ;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                       rdfs:label "has state"@en ;
                                       :sourceOntology <https://saref.etsi.org/core/> ;
                                       :sourceTermPage <https://saref.etsi.org/core/hasState> .


###  https://saref.etsi.org/core/isMeasuredIn
<https://saref.etsi.org/core/isMeasuredIn> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf :isUnitOfMeasureFor ;
                                           rdfs:domain <https://saref.etsi.org/core/PropertyValue> ;
                                           rdfs:range <https://saref.etsi.org/core/UnitOfMeasure> ;
                                           rdfs:comment "Reused to connect a value to its unit of measure."@en ;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                           rdfs:label "is measured in"@en ;
                                           :sourceOntology <https://saref.etsi.org/core/> ;
                                           :sourceTermPage <https://saref.etsi.org/core/isMeasuredIn> .


###  https://saref.etsi.org/saref4ener/belongsTo
<https://saref.etsi.org/saref4ener/belongsTo> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf :hasBelongingElement ;
                                              rdfs:domain :StructuralElement ;
                                              rdfs:range :StructuralContainer ;
                                              rdfs:comment "Reused to connect slots, power sequences, alternatives groups, and power profiles to their containing element."@en ;
                                              rdfs:isDefinedBy <https://saref.etsi.org/saref4ener/> ;
                                              rdfs:label "belongs to"@en ;
                                              :sourceOntology <https://saref.etsi.org/saref4ener/> ;
                                              :sourceTermPage <https://saref.etsi.org/saref4ener/belongsTo> .


###  https://w3id.org/bito#appliesTo
:appliesTo rdf:type owl:ObjectProperty ;
           owl:inverseOf :isAppliedBy ;
           rdfs:domain :BehavioralConstraint ;
           rdfs:range :BehavioralElement ;
           rdfs:comment "Links a behavioral constraint to the behavioral element it constrains."@en ;
           rdfs:isDefinedBy <https://w3id.org/bito> ;
           rdfs:label "applies to"@en ;
           :sourceOntology <https://w3id.org/bito> ;
           :sourceTermPage :appliesTo .


###  https://w3id.org/bito#basedOnTraceEvidence
:basedOnTraceEvidence rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isTraceEvidenceBasisOf ;
                      rdfs:domain :ValidationResult ;
                      rdfs:range :TraceEvidence ;
                      rdfs:comment "Links a validation result to the trace evidence used to derive it."@en ;
                      rdfs:isDefinedBy <https://w3id.org/bito> ;
                      rdfs:label "based on trace evidence"@en ;
                      :sourceOntology <https://w3id.org/bito> ;
                      :sourceTermPage :basedOnTraceEvidence .


###  https://w3id.org/bito#hasBehavioralConstraint
:hasBehavioralConstraint rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isBehavioralConstraintOf ;
                         rdfs:domain :Scenario ;
                         rdfs:range :BehavioralConstraint ;
                         rdfs:comment "Links a scenario to an applicable behavioral constraint."@en ;
                         rdfs:isDefinedBy <https://w3id.org/bito> ;
                         rdfs:label "has behavioral constraint"@en ;
                         :sourceOntology <https://w3id.org/bito> ;
                         :sourceTermPage :hasBehavioralConstraint .


###  https://w3id.org/bito#hasBelongingElement
:hasBelongingElement rdf:type owl:ObjectProperty ;
                     rdfs:domain :StructuralContainer ;
                     rdfs:range :StructuralElement ;
                     rdfs:comment "Links a structural container to a structural element it directly contains, such as a power sequence to its slots."@en ;
                     rdfs:isDefinedBy <https://w3id.org/bito> ;
                     rdfs:label "Has Belonging Element"@en ;
                     :sourceOntology <https://w3id.org/bito> ;
                     :sourceTermPage :hasBelongingElement .


###  https://w3id.org/bito#hasExpectedOperationalOutcome
:hasExpectedOperationalOutcome rdf:type owl:ObjectProperty ;
                               owl:inverseOf :isExpectedOperationalOutcomeOf ;
                               rdfs:domain :Scenario ;
                               rdfs:range :ExpectedOperationalOutcome ;
                               rdfs:comment "Links a scenario to the outcome expected from valid execution."@en ;
                               rdfs:isDefinedBy <https://w3id.org/bito> ;
                               rdfs:label "has expected operational outcome"@en ;
                               :sourceOntology <https://w3id.org/bito> ;
                               :sourceTermPage :hasExpectedOperationalOutcome .


###  https://w3id.org/bito#hasExpectedStateTransition
:hasExpectedStateTransition rdf:type owl:ObjectProperty ;
                            owl:inverseOf :isExpectedStateTransitionOf ;
                            rdfs:domain :Scenario ;
                            rdfs:range :ExpectedStateTransition ;
                            rdfs:comment "Links a scenario to an expected state transition."@en ;
                            rdfs:isDefinedBy <https://w3id.org/bito> ;
                            rdfs:label "has expected state transition"@en ;
                            :sourceOntology <https://w3id.org/bito> ;
                            :sourceTermPage :hasExpectedStateTransition .


###  https://w3id.org/bito#hasIUT
:hasIUT rdf:type owl:ObjectProperty ;
        owl:inverseOf :isIUTOf ;
        rdfs:domain :Scenario ;
        rdfs:range <https://saref.etsi.org/core/Device> ;
        rdfs:comment "Links a scenario to the implementation under test."@en ;
        rdfs:isDefinedBy <https://w3id.org/bito> ;
        rdfs:label "has IUT"@en ;
        :sourceOntology <https://w3id.org/bito> ;
        :sourceTermPage :hasIUT .


###  https://w3id.org/bito#hasInteractingActorSystem
:hasInteractingActorSystem rdf:type owl:ObjectProperty ;
                           owl:inverseOf :isInteractingActorSystemOf ;
                           rdfs:domain :Scenario ;
                           rdfs:range <http://www.w3.org/ns/prov#Agent> ;
                           rdfs:comment "Links a scenario to the external actor or system interacting with the IUT."@en ;
                           rdfs:isDefinedBy <https://w3id.org/bito> ;
                           rdfs:label "has interacting actor system"@en ;
                           :sourceOntology <https://w3id.org/bito> ;
                           :sourceTermPage :hasInteractingActorSystem .


###  https://w3id.org/bito#hasObservedEvent
:hasObservedEvent rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isObservedEventOf ;
                  rdfs:domain :ObservedExecution ;
                  rdfs:range :ObservedEvent ;
                  rdfs:comment "Links an observed execution to an observed event."@en ;
                  rdfs:isDefinedBy <https://w3id.org/bito> ;
                  rdfs:label "has observed event"@en ;
                  :sourceOntology <https://w3id.org/bito> ;
                  :sourceTermPage :hasObservedEvent .


###  https://w3id.org/bito#hasObservedExecution
:hasObservedExecution rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isObservedExecutionOf ;
                      rdfs:domain :Scenario ;
                      rdfs:range :ObservedExecution ;
                      rdfs:comment "Links a scenario to its observed execution evidence context."@en ;
                      rdfs:isDefinedBy <https://w3id.org/bito> ;
                      rdfs:label "has observed execution"@en ;
                      :sourceOntology <https://w3id.org/bito> ;
                      :sourceTermPage :hasObservedExecution .


###  https://w3id.org/bito#hasObservedSourceState
:hasObservedSourceState rdf:type owl:ObjectProperty ;
                        owl:inverseOf :isObservedSourceStateOf ;
                        rdfs:domain :ObservedStateChange ;
                        rdfs:range <https://saref.etsi.org/core/State> ;
                        rdfs:comment "Links an observed state change to its observed source state."@en ;
                        rdfs:isDefinedBy <https://w3id.org/bito> ;
                        rdfs:label "has observed source state"@en ;
                        :sourceOntology <https://w3id.org/bito> ;
                        :sourceTermPage :hasObservedSourceState .


###  https://w3id.org/bito#hasObservedStateChange
:hasObservedStateChange rdf:type owl:ObjectProperty ;
                        owl:inverseOf :isObservedStateChangeOf ;
                        rdfs:domain :ObservedExecution ;
                        rdfs:range :ObservedStateChange ;
                        rdfs:comment "Links an observed execution to an observed state change."@en ;
                        rdfs:isDefinedBy <https://w3id.org/bito> ;
                        rdfs:label "has observed state change"@en ;
                        :sourceOntology <https://w3id.org/bito> ;
                        :sourceTermPage :hasObservedStateChange .


###  https://w3id.org/bito#hasObservedTargetState
:hasObservedTargetState rdf:type owl:ObjectProperty ;
                        owl:inverseOf :isObservedTargetStateOf ;
                        rdfs:domain :ObservedStateChange ;
                        rdfs:range <https://saref.etsi.org/core/State> ;
                        rdfs:comment "Links an observed state change to its observed target state."@en ;
                        rdfs:isDefinedBy <https://w3id.org/bito> ;
                        rdfs:label "has observed target state"@en ;
                        :sourceOntology <https://w3id.org/bito> ;
                        :sourceTermPage :hasObservedTargetState .


###  https://w3id.org/bito#hasRelevantPowerSequence
:hasRelevantPowerSequence rdf:type owl:ObjectProperty ;
                          owl:inverseOf :isRelevantPowerSequenceOf ;
                          rdfs:domain :BehavioralElement ;
                          rdfs:range <https://saref.etsi.org/saref4ener/PowerSequence> ;
                          rdfs:comment "Links a behavioral element to the power sequence relevant for it."@en ;
                          rdfs:isDefinedBy <https://w3id.org/bito> ;
                          rdfs:label "has relevant power sequence"@en ;
                          :sourceOntology <https://w3id.org/bito> ;
                          :sourceTermPage :hasRelevantPowerSequence .


###  https://w3id.org/bito#hasScenario
:hasScenario rdf:type owl:ObjectProperty ;
             owl:inverseOf :isScenarioOf ;
             rdfs:domain :UseCase ;
             rdfs:range :Scenario ;
             rdfs:comment "Links a use case to a scenario that belongs to it."@en ;
             rdfs:isDefinedBy <https://w3id.org/bito> ;
             rdfs:label "has scenario"@en ;
             :sourceOntology <https://w3id.org/bito> ;
             :sourceTermPage :hasScenario .


###  https://w3id.org/bito#hasSourceState
:hasSourceState rdf:type owl:ObjectProperty ;
                owl:inverseOf :isSourceStateOf ;
                rdfs:domain :ExpectedStateTransition ;
                rdfs:range <https://saref.etsi.org/core/State> ;
                rdfs:comment "Links an expected transition to its source state."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "has source state"@en ;
                :sourceOntology <https://w3id.org/bito> ;
                :sourceTermPage :hasSourceState .


###  https://w3id.org/bito#hasTargetState
:hasTargetState rdf:type owl:ObjectProperty ;
                owl:inverseOf :isTargetStateOf ;
                rdfs:domain :ExpectedStateTransition ;
                rdfs:range <https://saref.etsi.org/core/State> ;
                rdfs:comment "Links an expected transition to its target state."@en ;
                rdfs:isDefinedBy <https://w3id.org/bito> ;
                rdfs:label "has target state"@en ;
                :sourceOntology <https://w3id.org/bito> ;
                :sourceTermPage :hasTargetState .


###  https://w3id.org/bito#hasTraceEvidence
:hasTraceEvidence rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isTraceEvidenceOf ;
                  rdfs:domain :ObservedExecution ;
                  rdfs:range :TraceEvidence ;
                  rdfs:comment "Links an observed execution to the trace evidence used for validation."@en ;
                  rdfs:isDefinedBy <https://w3id.org/bito> ;
                  rdfs:label "has trace evidence"@en ;
                  :sourceOntology <https://w3id.org/bito> ;
                  :sourceTermPage :hasTraceEvidence .


###  https://w3id.org/bito#hasTriggeringInteraction
:hasTriggeringInteraction rdf:type owl:ObjectProperty ;
                          owl:inverseOf :isTriggeringInteractionOf ;
                          rdfs:domain :Scenario ;
                          rdfs:range :ObservedEvent ;
                          rdfs:comment "Links a scenario to the event, request, command, signal, or condition that initiates or influences behavior."@en ;
                          rdfs:isDefinedBy <https://w3id.org/bito> ;
                          rdfs:label "has triggering interaction"@en ;
                          :sourceOntology <https://w3id.org/bito> ;
                          :sourceTermPage :hasTriggeringInteraction .


###  https://w3id.org/bito#hasValidationResult
:hasValidationResult rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isValidationResultOf ;
                     rdfs:domain :ObservedExecution ;
                     rdfs:range :ValidationResult ;
                     rdfs:comment "Links an observed execution to its validation result."@en ;
                     rdfs:isDefinedBy <https://w3id.org/bito> ;
                     rdfs:label "has validation result"@en ;
                     :sourceOntology <https://w3id.org/bito> ;
                     :sourceTermPage :hasValidationResult .


###  https://w3id.org/bito#hasVerdict
:hasVerdict rdf:type owl:ObjectProperty ;
            owl:inverseOf :isVerdictOf ;
            rdfs:domain :ValidationResult ;
            rdfs:range :ValidationVerdict ;
            rdfs:comment "Links a validation result to its verdict."@en ;
            rdfs:isDefinedBy <https://w3id.org/bito> ;
            rdfs:label "has verdict"@en ;
            :sourceOntology <https://w3id.org/bito> ;
            :sourceTermPage :hasVerdict .


###  https://w3id.org/bito#isAppliedBy
:isAppliedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :BehavioralElement ;
             rdfs:range :BehavioralConstraint ;
             rdfs:comment "Specifies the behavioral constraint that applies to this behavioral element."@en ;
             rdfs:isDefinedBy <https://w3id.org/bito> ;
             rdfs:label "Is Applied By"@en ;
             :sourceOntology <https://w3id.org/bito> ;
             :sourceTermPage :isAppliedBy .


###  https://w3id.org/bito#isBehavioralConstraintOf
:isBehavioralConstraintOf rdf:type owl:ObjectProperty ;
                          rdfs:domain :BehavioralConstraint ;
                          rdfs:range :Scenario ;
                          rdfs:comment "Specifies the scenario to which this behavioral constraint belongs."@en ;
                          rdfs:isDefinedBy <https://w3id.org/bito> ;
                          rdfs:label "Is Behavioral Constraint Of"@en ;
                          :sourceOntology <https://w3id.org/bito> ;
                          :sourceTermPage :isBehavioralConstraintOf .


###  https://w3id.org/bito#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               rdfs:domain :StructuralElement ;
               rdfs:range :StructuralContainer ;
               rdfs:comment "Links a structural element to the structural container it is part of, such as a slot to its power sequence."@en ;
               rdfs:isDefinedBy <https://w3id.org/bito> ;
               rdfs:label "Is Component Of"@en ;
               :sourceOntology <https://w3id.org/bito> ;
               :sourceTermPage :isComponentOf .


###  https://w3id.org/bito#isExpectedOperationalOutcomeOf
:isExpectedOperationalOutcomeOf rdf:type owl:ObjectProperty ;
                                rdfs:domain :ExpectedOperationalOutcome ;
                                rdfs:range :Scenario ;
                                rdfs:comment "Specifies the scenario of which this expected operational outcome is a part."@en ;
                                rdfs:isDefinedBy <https://w3id.org/bito> ;
                                rdfs:label "Is Expected Operational Outcome Of"@en ;
                                :sourceOntology <https://w3id.org/bito> ;
                                :sourceTermPage :isExpectedOperationalOutcomeOf .


###  https://w3id.org/bito#isExpectedStateTransitionOf
:isExpectedStateTransitionOf rdf:type owl:ObjectProperty ;
                             rdfs:domain :ExpectedStateTransition ;
                             rdfs:range :Scenario ;
                             rdfs:comment "Specifies the scenario of which this expected state transition is a part."@en ;
                             rdfs:isDefinedBy <https://w3id.org/bito> ;
                             rdfs:label "Is Expected State Transition Of"@en ;
                             :sourceOntology <https://w3id.org/bito> ;
                             :sourceTermPage :isExpectedStateTransitionOf .


###  https://w3id.org/bito#isIUTOf
:isIUTOf rdf:type owl:ObjectProperty ;
         rdfs:domain <https://saref.etsi.org/core/Device> ;
         rdfs:range :Scenario ;
         rdfs:comment "Specifies the scenario in which this device serves as the implementation under test."@en ;
         rdfs:isDefinedBy <https://w3id.org/bito> ;
         rdfs:label "Is IUT Of"@en ;
         :sourceOntology <https://w3id.org/bito> ;
         :sourceTermPage :isIUTOf .


###  https://w3id.org/bito#isInteractingActorSystemOf
:isInteractingActorSystemOf rdf:type owl:ObjectProperty ;
                            rdfs:domain <http://www.w3.org/ns/prov#Agent> ;
                            rdfs:range :Scenario ;
                            rdfs:comment "Specifies the scenario in which this agent acts as the interacting actor or system."@en ;
                            rdfs:isDefinedBy <https://w3id.org/bito> ;
                            rdfs:label "Is Interacting Actor System Of"@en ;
                            :sourceOntology <https://w3id.org/bito> ;
                            :sourceTermPage :isInteractingActorSystemOf .


###  https://w3id.org/bito#isObservedEventOf
:isObservedEventOf rdf:type owl:ObjectProperty ;
                   rdfs:domain :ObservedEvent ;
                   rdfs:range :ObservedExecution ;
                   rdfs:comment "Specifies the observed execution in which this observed event was recorded."@en ;
                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                   rdfs:label "Is Observed Event Of"@en ;
                   :sourceOntology <https://w3id.org/bito> ;
                   :sourceTermPage :isObservedEventOf .


###  https://w3id.org/bito#isObservedExecutionOf
:isObservedExecutionOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :ObservedExecution ;
                       rdfs:range :Scenario ;
                       rdfs:comment "Specifies the scenario for which this observed execution serves as evidence."@en ;
                       rdfs:isDefinedBy <https://w3id.org/bito> ;
                       rdfs:label "Is Observed Execution Of"@en ;
                       :sourceOntology <https://w3id.org/bito> ;
                       :sourceTermPage :isObservedExecutionOf .


###  https://w3id.org/bito#isObservedFormerPreferredPowerSequenceOf
:isObservedFormerPreferredPowerSequenceOf rdf:type owl:ObjectProperty ;
                                          owl:inverseOf :observedFormerPreferredPowerSequence ;
                                          rdfs:domain <https://saref.etsi.org/saref4ener/PowerSequence> ;
                                          rdfs:range :TraceEvidence ;
                                          rdfs:comment "Specifies the trace evidence in which this power sequence is the former preferred power sequence."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/bito> ;
                                          rdfs:label "Is Observed Former Preferred Power Sequence Of"@en ;
                                          :sourceOntology <https://w3id.org/bito> ;
                                          :sourceTermPage :isObservedFormerPreferredPowerSequenceOf .


###  https://w3id.org/bito#isObservedOptionalPowerSequenceOf
:isObservedOptionalPowerSequenceOf rdf:type owl:ObjectProperty ;
                                   owl:inverseOf :observedOptionalPowerSequence ;
                                   rdfs:domain <https://saref.etsi.org/saref4ener/PowerSequence> ;
                                   rdfs:range :TraceEvidence ;
                                   rdfs:comment "Specifies the trace evidence in which this power sequence is the observed optional power sequence."@en ;
                                   rdfs:isDefinedBy <https://w3id.org/bito> ;
                                   rdfs:label "Is Observed Optional Power Sequence Of"@en ;
                                   :sourceOntology <https://w3id.org/bito> ;
                                   :sourceTermPage :isObservedOptionalPowerSequenceOf .


###  https://w3id.org/bito#isObservedPreferredPowerSequenceOf
:isObservedPreferredPowerSequenceOf rdf:type owl:ObjectProperty ;
                                    owl:inverseOf :observedPreferredPowerSequence ;
                                    rdfs:domain <https://saref.etsi.org/saref4ener/PowerSequence> ;
                                    rdfs:range :TraceEvidence ;
                                    rdfs:comment "Specifies the trace evidence in which this power sequence is the observed preferred power sequence."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/bito> ;
                                    rdfs:label "Is Observed Preferred Power Sequence Of"@en ;
                                    :sourceOntology <https://w3id.org/bito> ;
                                    :sourceTermPage :isObservedPreferredPowerSequenceOf .


###  https://w3id.org/bito#isObservedScheduledPowerSequenceOf
:isObservedScheduledPowerSequenceOf rdf:type owl:ObjectProperty ;
                                    owl:inverseOf :observedScheduledPowerSequence ;
                                    rdfs:domain <https://saref.etsi.org/saref4ener/PowerSequence> ;
